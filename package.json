{
  "name": "pokeall",
  "private": true,
  "version": "0.2.0",
  "description": "Pokédex en chino, inglés y español: Pokémon, objetos, habilidades, movimientos y minijuegos",
  "homepage": "https://zxk1019.github.io/PokeAll/",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxk1019/PokeAll.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/sw-version.mjs",
    "preview": "vite preview",
    "data:download": "node scripts/download-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:extra": "node scripts/fill-missing.mjs && node scripts/build-data.mjs",
    "data": "npm run data:download && npm run data:build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "pinyin-pro": "3.29.5",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
